# Copy to .env for local development. Never commit real values.
HOST=127.0.0.1
PORT=3000
APP_DATA_DIR=./data
NODE_ENV=development

# Generate both with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
SESSION_KEY=REPLACE_WITH_32_BYTE_BASE64_KEY
ENCRYPTION_KEY=REPLACE_WITH_DIFFERENT_32_BYTE_BASE64_KEY
# Use a separate, random password of at least 20 characters to unlock Smart Mail.
APP_ACCESS_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD
