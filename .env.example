# Copy to .env for local development. Never commit real values.
APP_URL=http://127.0.0.1:1420
HOST=127.0.0.1
PORT=3000
APP_DATA_DIR=./data
NODE_ENV=development

# Generate both with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
SESSION_KEY=REPLACE_WITH_32_BYTE_BASE64_KEY
ENCRYPTION_KEY=REPLACE_WITH_DIFFERENT_32_BYTE_BASE64_KEY

# Create a Web OAuth client in Google Cloud. Add this exact redirect URI:
# http://127.0.0.1:1420/api/auth/google/callback
# and this Gmail redirect URI:
# http://127.0.0.1:1420/api/accounts/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ALLOWED_GOOGLE_EMAIL=your.email@example.com
